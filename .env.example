# Modelo de Hugging Face usado por el motor CAG (se define en la Fase 3)
MODEL_ID=
# Dispositivo de inferencia: cpu | cuda
DEVICE=cpu
# Límite de tokens del prefijo documental cargado en la caché KV
MAX_CONTEXT_TOKENS=

# Token para proteger los endpoints /admin/*
ADMIN_TOKEN=

# Ingesta: pausa entre solicitudes a sitios oficiales (segundos) y User-Agent identificable
REQUEST_DELAY_SECONDS=2
USER_AGENT=TramitaIA/0.1 (proyecto universitario)

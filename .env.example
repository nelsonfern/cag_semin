# Modelo de Hugging Face usado por el motor CAG (Fase 3: Qwen/Qwen2.5-1.5B-Instruct en CPU, float32)
MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
# Dispositivo de inferencia: cpu | cuda
DEVICE=cpu
# Precisión: bfloat16 | float32 | float16
DTYPE=float32
# Límite de tokens del prefijo documental cargado en la caché KV
MAX_CONTEXT_TOKENS=

# Token para proteger los endpoints /admin/*
ADMIN_TOKEN=

# Ingesta: pausa entre solicitudes a sitios oficiales (segundos) y User-Agent identificable
REQUEST_DELAY_SECONDS=2
USER_AGENT=TramitaIA/0.1 (proyecto universitario)

# Carpeta de modelos de Hugging Face (opcional; por defecto ~/.cache/huggingface)
# HF_HOME=D:\hf_cache

# Motor de inferencia: llamacpp (modelo GGUF cuantizado, el de TramitaIA desde la Fase 5) o
# transformers (PyTorch, MODEL_ID/DTYPE de arriba).
ENGINE=llamacpp
# Modelo GGUF: repo y archivo del Hub (se descarga la primera vez) con su commit fijo, o una ruta local.
LLAMACPP_REPO=bartowski/Qwen2.5-7B-Instruct-GGUF
LLAMACPP_FILE=Qwen2.5-7B-Instruct-Q4_K_M.gguf
LLAMACPP_REVISION=8911e8a47f92bac19d6f5c64a2e2095bd2f7d031
# LLAMACPP_MODEL_PATH=
# Plantilla de chat del modelo: chatml (Qwen) o llama3
LLAMACPP_TEMPLATE=chatml
# Hilos de CPU (en esta PC, 6 fue más rápido que 12) y atención optimizada de llama.cpp
LLAMACPP_THREADS=6
LLAMACPP_FLASH_ATTN=1

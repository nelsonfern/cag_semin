# Modelo de Hugging Face usado por el motor CAG (Fase 3: Qwen/Qwen2.5-1.5B-Instruct en CPU, float32)
MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
# Dispositivo de inferencia: cpu | cuda
DEVICE=cpu
# Precisión: bfloat16 | float32 | float16
DTYPE=float32
# Límite de tokens del prefijo documental cargado en la caché KV
MAX_CONTEXT_TOKENS=

# Token para proteger los endpoints /admin/*
ADMIN_TOKEN=

# Ingesta: pausa entre solicitudes a sitios oficiales (segundos) y User-Agent identificable
REQUEST_DELAY_SECONDS=2
USER_AGENT=TramitaIA/0.1 (proyecto universitario)

# Carpeta de modelos de Hugging Face (opcional; por defecto ~/.cache/huggingface)
# HF_HOME=D:\hf_cache
